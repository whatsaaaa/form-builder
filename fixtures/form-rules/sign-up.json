{
  "$schema": "../../packages/schema/definition.schema.json",
  "version": "1",
  "fields": [
    {
      "name": "username",
      "type": "text",
      "required": true,
      "rules": [
        {
          "rule": "trim"
        },
        {
          "rule": "toLowerCase"
        },
        {
          "rule": "minGraphemes",
          "value": 3,
          "message": "At least 3 characters"
        },
        {
          "rule": "maxBytes",
          "value": 32,
          "message": "Too long"
        },
        {
          "rule": "slug",
          "message": "Letters, digits and dashes only"
        }
      ]
    },
    {
      "name": "password",
      "type": "password",
      "required": true,
      "rules": [
        {
          "rule": "minLength",
          "value": 10,
          "message": "At least 10 characters"
        }
      ]
    },
    {
      "name": "confirmPassword",
      "type": "password",
      "label": "Repeat the password",
      "required": true
    },
    {
      "name": "age",
      "type": "number",
      "rules": [
        {
          "rule": "integer",
          "message": "Whole years"
        },
        {
          "rule": "minValue",
          "value": 16,
          "message": "You must be 16 or older"
        },
        {
          "rule": "toMaxValue",
          "value": 120
        }
      ]
    }
  ],
  "formRules": [
    {
      "rule": "differentFrom",
      "field": "password",
      "other": "username",
      "message": "Don't use your username as the password"
    },
    {
      "rule": "sameAs",
      "field": "confirmPassword",
      "other": "password",
      "message": "Passwords differ"
    }
  ]
}
