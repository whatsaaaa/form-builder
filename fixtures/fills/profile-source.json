{
  "$schema": "../../packages/fills/definition.schema.json",
  "version": "1",
  "fields": [
    {
      "name": "profile",
      "type": "select",
      "label": "Profile",
      "options": [
        { "value": "a", "label": "Profile A" },
        { "value": "b", "label": "Profile B" },
        { "value": "c", "label": "Profile C" }
      ],
      "fills": {
        "source": "profiles",
        "fields": ["firstName", "lastName", "email", "address.city"]
      }
    },
    {
      "name": "zip",
      "type": "text",
      "label": "ZIP code",
      "fills": { "source": "cities", "fields": ["address.city"], "overwrite": "always" }
    },
    { "name": "firstName", "type": "text", "label": "First name", "required": true },
    { "name": "lastName", "type": "text", "label": "Last name", "required": true },
    { "name": "email", "type": "email", "label": "Email" },
    {
      "name": "address",
      "type": "group",
      "label": "Address",
      "fields": [{ "name": "city", "type": "text", "label": "City" }]
    }
  ]
}
