{
  "name": "form-builder-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "build": "pnpm -r --filter '!docs' build",
    "test": "pnpm -r test",
    "type-check": "tsc --noEmit && pnpm -r type-check",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "@whatsaaaa/eslint-config": "^1.0.0",
    "@whatsaaaa/format-config": "^1.0.0",
    "@whatsaaaa/oxlint-config": "^1.0.0",
    "@whatsaaaa/tsconfig": "catalog:",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
