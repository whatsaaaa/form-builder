// The theme, which runs in the browser. Its own project keeps the Node.js target of the config's
// out of it, which the esbuild in VitePress's Vite doesn't know.
{
  "extends": "@whatsaaaa/tsconfig/bundler.json",
  "include": ["."],
  "compilerOptions": {
    "types": [],
    // The shared config turns these on; this code has never been held to them.
    "allowImportingTsExtensions": false,
    "erasableSyntaxOnly": false
  }
}
