{
  "name": "@whatsaaaa/form-builder-schema",
  "version": "0.3.0",
  "description": "Build Formisch-ready Valibot schemas from JSON form definitions.",
  "keywords": [
    "form",
    "formisch",
    "json",
    "schema"
  ],
  "homepage": "https://github.com/whatsaaaa/form-builder",
  "bugs": "https://github.com/whatsaaaa/form-builder/issues",
  "license": "MIT",
  "author": "Whatsaaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatsaaaa/form-builder.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint:pkg": "publint && pnpm pack --pack-destination .attw && attw .attw/*.tgz --profile esm-only",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "valibot": "^1.3.0"
  }
}
