{
  "name": "@whatsaaaa/form-builder-schema",
  "version": "0.0.0",
  "description": "Build Formisch-ready Valibot schemas from JSON form definitions.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.23.2",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "valibot": "^1.0.0"
  }
}
