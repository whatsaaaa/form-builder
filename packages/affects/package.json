{
  "name": "@whatsaaaa/form-builder-affects",
  "version": "0.2.1",
  "description": "Show, hide and clear the fields, sections and steps of JSON form definitions by conditions.",
  "keywords": [
    "conditional",
    "form",
    "formisch",
    "json",
    "schema"
  ],
  "homepage": "https://whatsaaaa.github.io/form-builder/guide/conditions",
  "bugs": "https://github.com/whatsaaaa/form-builder/issues",
  "license": "MIT",
  "author": "Whatsaaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatsaaaa/form-builder.git",
    "directory": "packages/affects"
  },
  "files": [
    "dist",
    "definition.schema.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./definition.schema.json": "./definition.schema.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./definition.schema.json": "./definition.schema.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit && tsc --noEmit -p scripts",
    "docs:gen": "jiti scripts/generate.ts",
    "lint:pkg": "publint && pnpm pack --pack-destination .attw && attw .attw/*.tgz --profile esm-only --exclude-entrypoints definition.schema.json",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@whatsaaaa/form-builder-schema": "workspace:^",
    "ajv": "^8.18.0",
    "jiti": "^2.7.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@whatsaaaa/form-builder-schema": "workspace:^",
    "valibot": "^1.3.0"
  }
}
