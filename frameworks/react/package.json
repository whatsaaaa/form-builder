{
  "name": "@whatsaaaa/form-builder-react",
  "version": "0.3.3",
  "description": "Render JSON form definitions with Formisch and your own React components.",
  "keywords": [
    "form",
    "formisch",
    "headless",
    "json",
    "react"
  ],
  "homepage": "https://github.com/whatsaaaa/form-builder",
  "bugs": "https://github.com/whatsaaaa/form-builder/issues",
  "license": "MIT",
  "author": "Whatsaaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatsaaaa/form-builder.git",
    "directory": "frameworks/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint:pkg": "publint && pnpm pack --pack-destination .attw && attw .attw/*.tgz --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "@whatsaaaa/form-builder-schema": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@formisch/react": "^1.2.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@whatsaaaa/form-builder-affects": "workspace:^",
    "happy-dom": "^20.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@formisch/react": "^1.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "valibot": "^1.4.1"
  }
}
