{
  "name": "@whatsaaaa/form-builder-vue",
  "version": "0.1.3",
  "description": "Render JSON form definitions with Formisch and your own Vue components.",
  "keywords": [
    "form",
    "formisch",
    "headless",
    "json",
    "vue"
  ],
  "homepage": "https://github.com/whatsaaaa/form-builder",
  "bugs": "https://github.com/whatsaaaa/form-builder/issues",
  "license": "MIT",
  "author": "Whatsaaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatsaaaa/form-builder.git",
    "directory": "frameworks/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint:pkg": "publint && pnpm pack --pack-destination .attw && attw .attw/*.tgz --profile esm-only"
  },
  "dependencies": {
    "@whatsaaaa/form-builder-schema": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@formisch/vue": "^1.1.1",
    "happy-dom": "^20.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@formisch/vue": "^1.1.1",
    "valibot": "^1.3.0",
    "vue": "^3.5.0"
  }
}
